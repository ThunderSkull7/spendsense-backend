APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Frontend Application URL (Password Reset Links) ---
# Canonical frontend origin hosting /authentication/forgot-password.html
# Development: http://localhost:3000 or http://127.0.0.1:3000
# Production: https://spendsensehq.pages.dev
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- PostgreSQL / Neon (hosted database) ---
# To use the hosted PostgreSQL database (Neon): set DB_CONNECTION=pgsql and
# uncomment the values below, filling them in from the Neon project's Connect
# panel (keep real credentials out of the repository and out of chat). Use the
# pooled host (...-pooler...) for application traffic, and the direct host for
# `php artisan migrate` and database dumps.
# DB_CONNECTION=pgsql
# DB_HOST=ep-<endpoint-id>.aws-<region>.neon.tech
# DB_PORT=5432
# DB_DATABASE=<database-name>
# DB_USERNAME=<role-name>
# DB_PASSWORD=<database-password>
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Sanctum first-party SPA auth / cookie hardening ---
# Comma-separated origins allowed to authenticate with the session cookie.
# Defaults already cover common local dev origins (localhost/127.0.0.1 :3000/:5173/:5500/:8000).
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Enable in production (HTTPS) so the session cookie is only sent over TLS.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Outbound Mail Delivery Configuration ---
# Local / CI testing default: log (writes MIME to storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@spendsensehq.com"
MAIL_FROM_NAME="SpendSense Security"

# --- Production Mail Provider Examples (Use Placeholders Only) ---
# Example 1: Amazon Simple Email Service (SES SMTP)
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=<your-ses-smtp-username>
# MAIL_PASSWORD=<your-ses-smtp-password>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="no-reply@spendsensehq.com"
# MAIL_FROM_NAME="SpendSense"

# Example 2: Postmark (SMTP)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USERNAME=<your-postmark-server-token>
# MAIL_PASSWORD=<your-postmark-server-token>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="security@spendsensehq.com"
# MAIL_FROM_NAME="SpendSense Security"

# Example 3: SendGrid (SMTP)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=<your-sendgrid-api-key>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="accounts@spendsensehq.com"
# MAIL_FROM_NAME="SpendSense"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://127.0.0.1:8002
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
