# SpendSense - PRODUCTION environment template
# Hosted setup: Render (backend) + Neon (PostgreSQL) + Cloudflare Pages (frontend).
#
# PLACEHOLDERS ONLY - no real credentials. Replace every REPLACE-WITH-* value
# in the host's environment settings (Render dashboard) or a server-local .env
# that is never committed. Never print or commit real secrets.
#
# Derived from .env.example; only keys relevant to the hosted setup are listed.
# Anything not shown here keeps its framework default.

APP_NAME=SpendSense
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.REPLACE-WITH-YOUR-DOMAIN
# Generate per environment with:  php artisan key:generate --show
APP_KEY=base64:REPLACE-WITH-GENERATED-APP-KEY

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Platform (Render) ---------------------------------------------------------
# PORT is injected by Render at runtime; do not define it here.
# TLS terminates at Render's edge; the app trusts its proxy headers
# (see bootstrap/app.php -> trustProxies).

# --- Database (Neon PostgreSQL, DIRECT host) ------------------------------------
# Use the direct (non-pooler) endpoint: DB_HOST must NOT contain "-pooler".
# Leave DB_URL unset - if present it overrides the DB_* values below.
DB_CONNECTION=pgsql
DB_HOST=ep-REPLACE-WITH-ENDPOINT-ID.aws-REPLACE-WITH-REGION.neon.tech
DB_PORT=5432
DB_DATABASE=REPLACE-WITH-DATABASE-NAME
DB_USERNAME=REPLACE-WITH-ROLE-NAME
DB_PASSWORD=REPLACE-WITH-DATABASE-PASSWORD
DB_SSLMODE=require

# --- Session / Sanctum (frontend and API share one registrable domain) ----------
# Leading dot -> cookies are shared across app.<domain> and api.<domain>.
# REQUIRED for Sanctum: the static frontend reads the XSRF-TOKEN cookie via
# document.cookie to send the X-XSRF-TOKEN header; a host-only cookie on
# api.<domain> would be invisible to app.<domain> and every write request
# would fail with 419. The session cookie stays HttpOnly regardless.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.REPLACE-WITH-YOUR-DOMAIN

# Frontend host only, no scheme. Example: app.REPLACE-WITH-YOUR-DOMAIN
SANCTUM_STATEFUL_DOMAINS=app.REPLACE-WITH-YOUR-DOMAIN
# Full frontend origin; must share the registrable domain with APP_URL.
CORS_ALLOW_ORIGINS=https://app.REPLACE-WITH-YOUR-DOMAIN

# --- Runtime services -------------------------------------------------------------
# The app dispatches no queued jobs: run synchronously, no worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
BROADCAST_CONNECTION=log
