# SpendSense - PRODUCTION environment template
# Hosted setup: Render (backend) + Neon (PostgreSQL) + Cloudflare Pages (frontend).
#
# DOCUMENTATION TEMPLATE ONLY - this file contains placeholders, not real
# credentials. Replace every REPLACE-WITH-* value in the host's environment
# settings (Render dashboard) or a server-local .env that is never committed.
# Never treat this file as a source of live secrets, and never print or commit
# real credentials.
#
# Derived from .env.example; only keys relevant to the hosted setup are listed.
# Anything not shown here keeps its framework default.

APP_NAME=SpendSense
APP_ENV=production
APP_DEBUG=false
APP_URL=https://spendsense-api-t0up.onrender.com
# Generate per environment with:  php artisan key:generate --show
APP_KEY=base64:REPLACE-WITH-GENERATED-APP-KEY

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Platform (Render) ---------------------------------------------------------
# PORT is injected by Render at runtime; do not define it here.
# TLS terminates at Render's edge; the app trusts its proxy headers
# (see bootstrap/app.php -> trustProxies).

# --- Database (Neon PostgreSQL, DIRECT host) ------------------------------------
# Use the direct (non-pooler) endpoint: DB_HOST must NOT contain "-pooler".
# Leave DB_URL unset - if present it overrides the DB_* values below.
DB_CONNECTION=pgsql
DB_HOST=ep-REPLACE-WITH-ENDPOINT-ID.aws-REPLACE-WITH-REGION.neon.tech
DB_PORT=5432
DB_DATABASE=REPLACE-WITH-DATABASE-NAME
DB_USERNAME=REPLACE-WITH-ROLE-NAME
DB_PASSWORD=REPLACE-WITH-DATABASE-PASSWORD
DB_SSLMODE=require

# --- Session / Sanctum (Pages browser -> same-origin worker -> Render API) ------
# The browser only talks to https://spendsensehq.pages.dev. The Pages worker
# proxies /api/* and the exact /user endpoint to Render, so the session and
# XSRF cookies are set on the Pages host and remain readable by the Pages
# JavaScript. The session cookie itself stays HttpOnly.
#
# SESSION_DOMAIN must stay unset/empty so the cookie is host-only for
# spendsensehq.pages.dev. Do NOT set .onrender.com or .pages.dev: either value
# prevents the browser from storing/reading the cookies correctly.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SESSION_DOMAIN=

# Sanctum receives the Pages host as the browser-facing stateful domain.
SANCTUM_STATEFUL_DOMAINS=spendsensehq.pages.dev
# Exact Pages origin. Do not point this at the Render API URL or add a path.
CORS_ALLOW_ORIGINS=https://spendsensehq.pages.dev

# --- Runtime services -------------------------------------------------------------
# The app dispatches no queued jobs: run synchronously, no worker needed.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
BROADCAST_CONNECTION=log
